@model BPAMatchineTrack.Models.ViewModel.LoginViewModel
@{
    ViewData["Title"] = "Cotton Club";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="card shadow-lg p-4" style="width: 380px; border-radius: 12px;">

        <!-- Logo -->
        <div class="text-center mb-4">
            <img src="~/images/images.jpeg" />
            <h5 class="mt-3 fw-bold text-primary">Welcome to Machine Tracking System </h5>
            <p class="text-muted small">Please login to your account</p>
        </div>

        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

            <!-- Email -->
            <div class="form-group mb-3">
                <label class="form-label">Username</label>
                <input asp-for="Email" class="form-control" type="text" placeholder="Enter your User Name"
                       value="@ViewData["RememberedEmail"]" />  <!-- Use the passed cookie value -->
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <!-- Password -->
            @* <div class="form-group mb-3">
                <label class="form-label">Password</label>
                <input asp-for="Password" class="form-control" type="password" placeholder="Enter your password"
                       value="@ViewData["RememberedPassword"]" />  <!-- Use the passed cookie value -->
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div> *@
            <div class="form-group mb-3 position-relative">
                <label class="form-label">Password</label>
                <input asp-for="Password" id="passwordInput" class="form-control" type="password" placeholder="Enter your password"
                       value="@Context.Request.Cookies["RememberedPassword"]" />
                <i id="togglePassword" class="fas fa-eye-slash position-absolute" style="top: 50%; right: 10px; cursor: pointer;"></i>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <!-- Remember Me -->
            @* <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label class="form-check-label">Remember Me</label>
            </div> *@

            <div class="form-check mb-3">
                <!-- Manually write the input tag and use Razor to conditionally set the "checked" attribute -->
                <input type="checkbox" name="RememberMe" class="form-check-input"
                       value="true"
                       @if (Context.Request.Cookies["RememberMeChecked"] == "true")
                       {
                           @:checked="checked"
                       }
 />
                <label class="form-check-label">Remember Me</label>
            </div>

            <!-- Login Button -->
            <button type="submit" class="btn btn-primary w-100">
                Login
            </button>
        </form>

        <!-- Register -->
        <div class="text-center mt-3">
            <small>
                Don’t have an account?
                <a asp-controller="Account" asp-action="Register" class="text-decoration-none">
                    Register here
                </a>
            </small>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Toggle password visibility
        const togglePassword = document.getElementById("togglePassword");
        const passwordInput = document.getElementById("passwordInput");

        togglePassword.addEventListener("click", function () {
            // Toggle the type attribute
            const type = passwordInput.type === "password" ? "text" : "password";
            passwordInput.type = type;

            // Toggle the icon
            this.classList.toggle("fa-eye-slash");
            this.classList.toggle("fa-eye");
        });
    </script>
}