@model BPAMatchineTrack.Models.TblMachineTypeInfo

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Machine Type Info..</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger">Type Name</div>
            <input type="hidden" asp-for="Mtid" />
            <div class="form-group">
                <label asp-for="Name" class="control-label" style="color: navy; font-weight: bold;"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label" style="color: navy; font-weight: bold;"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Status" class="control-label" style="color: navy; font-weight: bold;">Status</label>
                <select asp-for="Status" class="form-control" asp-items="@(new List<SelectListItem> {
        new SelectListItem { Value = "Active", Text = "Active" },
        new SelectListItem { Value = "Inactive", Text = "Inactive" }
    })">
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Update" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
