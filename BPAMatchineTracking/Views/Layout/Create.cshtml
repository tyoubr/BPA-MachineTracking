@* @model BPAMachineTrack.Models.tbl_Layout *@

@{
    ViewData["Title"] = "Create";
}
@* <link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css" rel="stylesheet" />
 *@
<!-- Include Select2 CSS -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/css/select2.min.css" rel="stylesheet" />

<!-- Include Select2 JS -->



<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10 col-12">
            <div class="card shadow-lg p-4 rounded-lg">
                <div class="card-body">
                    <h1 class="text-center text-primary mb-4">Set Machine's Current Location</h1>
                    <hr />

                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- DATE -->
                        <div class="form-group mb-3">
                            <label asp-for="DATE" class="form-label">Date</label>
                            <input asp-for="DATE" class="form-control form-control-lg shadow-sm" placeholder="Select Date" type="date" />
                            <span asp-validation-for="DATE" class="text-danger"></span>
                        </div>

                        <!-- MACHINE ID Dropdown -->
                        <div class="form-group mb-3">
                            <label for="machineDropdown" class="form-label">Select Machine</label>
                            @* <select id="machineDropdown" name="MCID" class="form-select">
                                <option value="">-- Select a Machine --</option>
                            </select> *@
                            <select id="machineDropdown" name="MCID" class="form-select">
                                <option></option>
                            </select>
                            <span asp-validation-for="MCID" class="text-danger"></span>
                        </div>

                        <!-- LID Dropdown -->
                        <div class="form-group mb-3">
                            <label for="lidDropdown" class="form-label">Select Location</label>
                            @* <select id="lidDropdown" name="LID" class="form-select">
                                <option value="">-- Select a Location --</option>
                            </select> *@
                            <select id="lidDropdown" name="LID" class="form-select">
                                <option></option>
                            </select>
                            <span asp-validation-for="LID" class="text-danger"></span>
                        </div>

                        <!-- LOCATION DETAILS -->
                        <div class="form-group mb-3">
                            <label asp-for="LOCATION_DETAILS" class="form-label">Location Details</label>
                            <input id="LOCATION_DETAILS" asp-for="LOCATION_DETAILS" class="form-control form-control-lg shadow-sm" readonly />
                            <span asp-validation-for="LOCATION_DETAILS" class="text-danger"></span>
                        </div>

                        <!-- STATUS -->
                        <div class="form-group mb-4">
                            <label asp-for="STATUS" class="form-label">Status</label>
                            <select asp-for="STATUS" class="form-control form-control-lg shadow-sm">
                                <option value="">Select Machine Status</option>
                                <option value="Running">Running</option>
                                <option value="Idle">Idle</option>
                                <option value="Under maintenance">Under maintenance</option>
                                <option value="Damaged">Damaged</option>
                            </select>
                            <span asp-validation-for="STATUS" class="text-danger"></span>
                        </div>

                        <!-- Submit Button -->
                        <div class="d-flex justify-content-center">
                            <button type="submit" class="btn btn-primary btn-lg px-5 py-3 rounded-pill shadow-lg">Create</button>
                        </div>
                    </form>

                    <!-- Back to List -->
                    <div class="text-center mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-4 py-2 rounded-pill shadow-sm">Back to List</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/js/select2.min.js"></script>
    <script>

        $(document).ready(function () {
            // Load Machine IDs
            $.ajax({
                url: '/Layout/GetAllMachineIds',
                type: 'GET',
                success: function (response) {
                    if (response.success) {
                        const dropdown = $('#machineDropdown');
                        // dropdown.empty().append('<option value="">-- Select a Machine --</option>');
                        dropdown.empty().append('<option></option>');
                        response.data.forEach(machine => {
                            dropdown.append(`<option value="${machine.mcid}">${machine.mcid} - ${machine.srno}</option>`);
                        });
                        dropdown.select2({
                            placeholder: "Type to search by MCID or Name",
                            allowClear: true,
                            width: '100%'
                        });
                    } else {
                        alert(response.message || 'Failed to load machine IDs.');
                    }
                },
                error: function () {
                    alert('Error loading machine data. Please try again later.');
                }
            });

            // Load Location IDs
            $.ajax({
                url: '/Layout/GetAllLocationIds',
                type: 'GET',
                success: function (response) {
                    if (response.success) {
                        const dropdown = $('#lidDropdown');
                        // dropdown.empty().append('<option value="">-- Select a Location --</option>');
                        dropdown.empty().append('<option></option>');
                        response.data.forEach(location => {
                            dropdown.append(`<option value="${location.lid}">${location.lid} - ${location.name}</option>`);
                        });
                        dropdown.select2({
                            placeholder: "Type to search by Location ID or Name",
                            allowClear: true,
                            width: '100%'
                        });
                    } else {
                        alert(response.message || 'Failed to load location IDs.');
                    }
                },
                error: function () {
                    alert('Error loading location data. Please try again later.');
                }
            });

            // Fetch Location Details
            $('#lidDropdown').on('change', function () {
                const lid = $(this).val();
                if (lid) {
                    $.ajax({
                        url: '/Layout/GetLocationDetails',
                        type: 'GET',
                        data: { Lid: lid },
                        success: function (response) {
                            if (response.success) {
                                const details = response.data;
                                $('#LOCATION_DETAILS').val(`${details.companyName} - ${details.buildingName}, ${details.floorName}`);
                            } else {
                                alert(response.message || 'Failed to retrieve location details.');
                            }
                        },
                        error: function () {
                            alert('Error retrieving location details. Please try again later.');
                        }
                    });
                } else {
                    $('#LOCATION_DETAILS').val('');
                }
            });

            // Set default date
            const today = new Date().toISOString().split('T')[0];
            $('#DATE').val(today);
        });
    </script>

}
