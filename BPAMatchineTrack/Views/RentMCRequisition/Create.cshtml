@model BPAMatchineTrack.ViewModels.RentMCRequisitionViewModel

<div class="row">
    <div class="col-md-8 offset-md-2">
        <!-- Requisition Form in a Card Layout -->
        <div class="card border-primary shadow-sm">
            <div class="card-header text-white bg-primary">
                <h3 class="card-title">Requisition Form</h3>
            </div>
            <form asp-action="Create" method="post" role="form">
                <div class="card-body">
                    <div class="row">
                        <!-- Requisition Date -->
                        <div class="form-group col-md-6">
                            <label for="Requisition.RDate">Requisition Date</label>
                            <div class="input-group">
                                <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
                                <input type="date" name="Requisition.RDate" class="form-control"
                                       value="@Model.Requisition.RDATE?.ToString("yyyy-MM-dd")" readonly />
                            </div>
                        </div>

                        <!-- Booking No -->
                        <div class="form-group col-md-6">
                            <label for="Booking_No">Booking No</label>
                            <input type="text" id="Booking_No" name="Booking_No" class="form-control"
                                   title="Enter a valid booking number" placeholder="Enter Booking No" required />

                            <span asp-validation-for="Booking_No" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <!-- Requested For -->
                        <div class="form-group col-md-6">
                            <label for="Req_For">Requested For</label>
                            <input type="text" id="Req_For" name="Req_For" class="form-control"
                                   value="@Model.Req_For" placeholder="Enter Request For" required />
                            <span asp-validation-for="Req_For" class="text-danger"></span>
                        </div>

                        <!-- Required Date -->
                        <div class="form-group col-md-6">
                            <label for="Required_Date">Request Date</label>
                            <div class="input-group">
                                <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
                                <input type="date" id="Required_Date" name="Req_Date" class="form-control"
                                       value="@Model.Req_Date?.ToString("yyyy-MM-dd")" required />
                                <span asp-validation-for="Req_Date" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <!-- Company Dropdown -->
                        <div class="form-group col-md-6">
                            <label for="SelectedCompanyId">Company</label>
                            <select id="SelectedCompanyId" name="SelectedCompanyId" onchange="loadBuildings()" class="form-control select2" required>
                                <option value="">Select Company</option>
                                @foreach (var company in Model.Companies)
                                {
                                    <option value="@company.Cid">@company.CompanyName</option>
                                }
                            </select>
                            <span asp-validation-for="SelectedCompanyId" class="text-danger"></span>
                        </div>


                       @*  <div class="form-group col-md-6">
                            <label for="SelectedCompanyId">Company</label>
                            <select id="SelectedCompanyId" name="SelectedCompanyId" onchange="loadBuildings()" class="form-control select2" required>
                                <option value="">Select Company</option>
                                @foreach (var company in Model.Companies)
                                {
                                    <option value="@company.Cid">@company.CompanyName</option>
                                }
                            </select>
                        </div> *@

                        <!-- Building Dropdown -->
                        <div class="form-group col-md-6">
                            <label for="SelectedBuildingId">Building</label>
                            <select id="SelectedBuildingId" name="SelectedBuildingId" onchange="loadFloors()" class="form-control select2" required>
                                <option value="">Select Building</option>
                                @foreach (var building in Model.Buildings)
                                {
                                    <option value="@building.Buid">@building.Name</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <!-- Floor Dropdown -->
                        <div class="form-group col-md-6">
                            <label for="SelectedFloorId">Floor</label>
                            <select id="SelectedFloorId" name="SelectedFloorId" onchange="loadLocations()" class="form-control select2" required>
                                <option value="">Select Floor</option>
                                @foreach (var floor in Model.Floors)
                                {
                                    <option value="@floor.Fid">@floor.Name</option>
                                }
                            </select>
                        </div>

                        <!-- Location Dropdown -->
                        <div class="form-group col-md-6">
                            <label for="SelectedLocationId">Location</label>
                            <select id="SelectedLocationId" name="SelectedLocationId" class="form-control select2" required>
                                <option value="">Select Location</option>
                                @foreach (var location in Model.Locations)
                                {
                                    <option value="@location.Lid">@location.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Machine Details Table -->
                <div class="card-body">
                    <h4 class="mt-4">Details</h4>
                    <div class="table-responsive">
                        <table id="detailsTable" class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>Machine Type</th>
                                    <th>Quantity</th>
                                    <th>Remark</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>
                                        <select name="RequisitionDetails[0].MTID" class="form-control select2" required>
                                            <option value="">Select Machine Type</option>
                                            @foreach (var machineType in Model.MachineTypes)
                                            {
                                                <option value="@machineType.Mtid">@machineType.Name</option>
                                            }
                                        </select>
                                    </td>
                                    <td>
                                        <input type="number" name="RequisitionDetails[0].QTY" class="form-control" required />
                                    </td>
                                    <td>
                                        <input type="text" name="RequisitionDetails[0].Remarks" class="form-control" placeholder="Enter remark" />
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-danger remove-row"><i class="fa fa-trash"></i></button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <button type="button" id="addDetailRow" class="btn btn-primary"><i class="fa fa-plus"></i> Add Detail</button>
                </div>

                <!-- Submit Button -->
                <div class="card-footer">
                    <button type="submit" class="btn btn-success"><i class="fa fa-check"></i> Submit</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Include jQuery and Select2 -->
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script>

<script>
    // Initialize Select2
    $(document).ready(function () {
        $('.select2').select2();
    });

    // Load Buildings
    function loadBuildings() {
        var companyId = $('#SelectedCompanyId').val();
        if (companyId) {
            $.getJSON('/RentMCRequisition/GetBuildingsByCompany', { companyId: companyId }, function (buildings) {
                var buildingDropdown = $('#SelectedBuildingId');
                buildingDropdown.empty().append('<option value="">Select Building</option>');
                $.each(buildings, function (i, building) {
                    buildingDropdown.append($('<option>', {
                        value: building.buildingId,
                        text: building.buildingName
                    }));
                });
            });
        }
    }

    // Load Floors
    function loadFloors() {
        var buildingId = $('#SelectedBuildingId').val();
        if (buildingId) {
            $.getJSON('/RentMCRequisition/GetFloorsByBuilding', { buildingId: buildingId }, function (floors) {
                var floorDropdown = $('#SelectedFloorId');
                floorDropdown.empty().append('<option value="">Select Floor</option>');
                $.each(floors, function (i, floor) {
                    floorDropdown.append($('<option>', {
                        value: floor.floorId,
                        text: floor.floorName
                    }));
                });
            });
        }
    }

    // Load Locations
    function loadLocations() {
        var floorId = $('#SelectedFloorId').val();
        if (floorId) {
            $.getJSON('/RentMCRequisition/GetLocationsByFloor', { floorId: floorId }, function (locations) {
                var locationDropdown = $('#SelectedLocationId');
                locationDropdown.empty().append('<option value="">Select Location</option>');
                $.each(locations, function (i, location) {
                    locationDropdown.append($('<option>', {
                        value: location.locationId,
                        text: location.locationName
                    }));
                });
            });
        }
    }

    // Add Detail Row
    $('#addDetailRow').click(function () {
        var newRowIndex = $('#detailsTable tbody tr').length;
        var newRow = `
                <tr>
                    <td>
                        <select name="RequisitionDetails[${newRowIndex}].MTID" class="form-control select2" required>
                            <option value="">Select Machine Type</option>
    @foreach (var machineType in Model.MachineTypes)
    {
                                    <option value="@machineType.Mtid">@machineType.Name</option>
    }
                        </select>
                    </td>
                    <td>
                        <input type="number" name="RequisitionDetails[${newRowIndex}].QTY" class="form-control" required />
                    </td>
                    <td>
                        <input type="text" name="RequisitionDetails[${newRowIndex}].Remarks" class="form-control" placeholder="Enter remark" />
                    </td>
                    <td>
                        <button type="button" class="btn btn-danger remove-row"><i class="fa fa-trash"></i></button>
                    </td>
                </tr>`;
        $('#detailsTable tbody').append(newRow);
        $('.select2').select2();
    });

    // Remove Detail Row
    $(document).on('click', '.remove-row', function () {
        if (confirm('Are you sure you want to delete this row?')) {
            $(this).closest('tr').remove();
        }
    });

</script>
