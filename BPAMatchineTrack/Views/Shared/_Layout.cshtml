<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BPAMatchineTrack</title>
    <link rel="stylesheet" href="~/plugins/fontawesome-free/css/all.min.css" />
    <link rel="stylesheet" href="~/dist/css/adminlte.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="hold-transition sidebar-mini">
    <div class="wrapper">
        <!-- Navbar -->
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <a href="~/Home/Index" class="nav-link"><i class="fas fa-home"></i> Home</a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <a href="~/Home/Privacy" class="nav-link"><i class="fas fa-shield-alt"></i> Privacy</a>
                </li>
            </ul>
        </nav>
        <!-- /.navbar -->
        <!-- Main Sidebar Container -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <!-- Brand Logo -->
            <a href="~/Home/Index" class="brand-link">
                <img src="~/Images/logo.png" alt="AdminLTE Logo" class="brand-image elevation-3" style="opacity: .8; width: 100px; height: auto;">
                <span class="brand-text font-weight-light">McTrack</span>
            </a>
            <!-- Sidebar -->
            <div class="sidebar">
                <!-- Sidebar user panel (optional) -->
                <div class="user-panel mt-3 pb-3 mb-3 d-flex">
                    <div class="image">
                        <img src="~/dist/img/user2-160x160.jpg" class="img-circle elevation-2" alt="User Image">
                    </div>
                    <div class="info">
                        <a href="#" class="d-block"><i class="fas fa-user"></i> BPA</a>
                    </div>
                </div>
                <!-- Sidebar Menu -->
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                        <li class="nav-item has-treeview">
                            <a href="#" class="nav-link">
                                <i class="nav-icon fas fa-info-circle"></i>
                                <p>
                                    Initial Information
                                    <i class="right fas fa-angle-left"></i>
                                </p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a href="~/Company/Index" class="nav-link">
                                        <i class="far fa-building nav-icon"></i>
                                        <p>Company Information</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="~/Building/Index" class="nav-link">
                                        <i class="fas fa-warehouse nav-icon"></i>
                                        <p>Building Information</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="~/Floor/Index" class="nav-link">
                                        <i class="fas fa-layer-group nav-icon"></i>
                                        <p>Floor Information</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="~/McLocations/Index" class="nav-link">
                                        <i class="fas fa-map-marker-alt nav-icon"></i>
                                        <p>MC Location Info..</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="~/MachineTypeInfo/Index" class="nav-link">
                                        <i class="fas fa-cogs nav-icon"></i>
                                        <p>MC Type Info..</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="~/BrandInformation/Index" class="nav-link">
                                        <i class="fas fa-tag nav-icon"></i>
                                        <p>Brand Information</p>
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a href="~/BrandInformation/Index" class="nav-link">
                                        <i class="fas fa-wrench nav-icon"></i>
                                        <p>Spare Parts Information</p>
                                    </a>
                                </li>


                            </ul>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "MachineDetail")" class="nav-link">
                                <i class="nav-icon fas fa-info-circle"></i>
                                <p>
                                    Machine Information
                                </p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "ScanInformation")" class="nav-link">
                                <i class="nav-icon fas fa-barcode"></i>
                                <p>
                                    Scan Machines
                                </p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "RentMCRequisition")" class="nav-link">
                                <i class="nav-icon fas fa-money-check-alt"></i>
                                <p>
                                    Rent M/C Requisition
                                </p>
                            </a>
                        </li>
                      
                        
                        @*  <li class="nav-item">
                            <a href="@Url.Action("Index", "ScanInformation")" class="nav-link">
                                <i class="nav-icon fas fa-screwdriver"></i>
                                <p>
                                    Consumption Info (SP)
                                </p>
                            </a>
                        </li> *@
                        <li class="nav-item has-treeview">
                            <a href="#" class="nav-link">
                                <i class="nav-icon fas fa-chart-pie"></i>
                                <p>
                                    Reports
                                    <i class="right fas fa-angle-left"></i>
                                </p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a href="~/ReportCalling/test1" class="nav-link">
                                        <i class="far fa-file-alt"></i>
                                        <p>Scan Report (TKL)</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="~/ReportCalling/MachineInfo_CCBDL" class="nav-link">
                                        <i class="far fa-file-alt"></i>
                                        <p>Scan Report (CCLBD)</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="~/ReportCalling/MachineInfo_CCBLE" class="nav-link">
                                        <i class="far fa-file-alt"></i>
                                        <p>Scan Report (CCBLE)</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="~/ReportCalling/MachineInfo_CCBD" class="nav-link">
                                        <i class="far fa-file-alt"></i>
                                        <p>Scan Report (CCBD)</p>
                                    </a>
                                </li>

                            </ul>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a href="~/ReportCalling/test2" class="nav-link">
                                        <i class="far fa-file-alt"></i>
                                        <p>Print Machine's Sticker'</p>
                                    </a>
                                </li>
                            </ul>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a href="~/ReportCalling/test3" class="nav-link">
                                        <i class="far fa-file-alt"></i>
                                        <p>Print Location's Sticker'</p>
                                    </a>
                                </li>
                            </ul>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a href="~/ReportCalling/MachineInfo" class="nav-link">
                                        <i class="far fa-file-alt"></i>
                                        <p>Sewing Machine Details</p>
                                    </a>
                                </li>
                            </ul>
                             <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a href="~/ReportCalling/RentMCRequisition" class="nav-link">
                                        <i class="far fa-file-alt"></i>
                                        <p>Rental Machine Requisition</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="~/ReportCalling/RentalMachineStatus" class="nav-link">
                                        <i class="far fa-file-alt"></i>
                                        <p>Rental Machine Status</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="~/ReportCalling/IdleMachineStatus" class="nav-link">
                                        <i class="far fa-file-alt"></i>
                                        <p>Idle Machine Status</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="~/ReportCalling/UMMachineStatus" class="nav-link">
                                        <i class="far fa-file-alt"></i>
                                        <p>Under Maintenance Machine Status</p>
                                    </a>
                                </li>
                                
                            </ul>
                        </li>
                    </ul>
                </nav>
                <!-- /.sidebar-menu -->
            </div>
            <!-- /.sidebar -->
        </aside>

        <!-- Content Wrapper. Contains page content -->
        <div class="content-wrapper">
            <section class="content">
                <div class="container-fluid">
                    @RenderBody()  <!-- This renders the body of the child views -->
                </div>
            </section>
        </div>
        <!-- /.content-wrapper -->

        <footer class="main-footer">
            <div class="float-right d-none d-sm-block">
                <b>Version</b> 3.2.0
            </div>
            <strong>Copyright &copy; 2024 <a href="https://tyoubr.com">tyoubr@gmail.com</a>.</strong> All rights reserved.
        </footer>
    </div>
    <!-- ./wrapper -->
    <!-- jQuery -->
   

    <script src="~/plugins/jquery/jquery.min.js"></script>
    <script src="~/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/dist/js/adminlte.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
