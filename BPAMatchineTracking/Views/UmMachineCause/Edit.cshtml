@model BPAMatchineTrack.Models.TblMcUmCause

@{
    ViewData["Title"] = "Edit Cause";
}

<h1>Edit</h1>

<h4>Cause Information</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Umcid" />
            <div class="form-group">
                <label asp-for="CauseName" class="control-label" style="color: navy; font-weight: bold;">Cause Name</label>
                <input asp-for="CauseName" class="form-control" />
                <span asp-validation-for="CauseName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Status" class="control-label" style="color: navy; font-weight: bold;">Status</label>
                <select asp-for="Status" class="form-control" asp-items="@(new List<SelectListItem> {
                                                                      new SelectListItem { Value = "Active", Text = "Active" },
                                                                      new SelectListItem { Value = "Inactive", Text = "Inactive" }
                                                                  })">
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Remarks" class="control-label" style="color: navy; font-weight: bold;">Remarks</label>
                <input asp-for="Remarks" class="form-control" />
                <span asp-validation-for="Remarks" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Update" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
