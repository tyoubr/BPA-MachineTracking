@model IEnumerable<BPAMatchineTrack.Models.TblMcLocation>

@{
    ViewData["Title"] = "Machine Locations";
}

<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Machine Location</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="~/Home/Index">Home</a></li>
                    <li class="breadcrumb-item active">Machine Location</li>
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Machine Location List</h3>
                        <div class="card-tools">
                            <a asp-action="Create" class="btn btn-primary btn-sm">Create New</a>
                        </div>
                    </div>
                    <!-- /.card-header -->
                    <div class="card-body table-responsive p-0">
                        <table id="machineLocationTable" class="table table-hover text-nowrap">
                            <thead>
                                <tr>
                                    <th>@Html.DisplayNameFor(model => model.Name)</th>
                                    <th>@Html.DisplayNameFor(model => model.Status)</th>
                                    <th>@Html.DisplayNameFor(model => model.Remarks)</th>
                                    <th>@Html.DisplayName("Floor")</th>
                                    <th>@Html.DisplayName("Building")</th>
                                    <th>@Html.DisplayName("Company")</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@Html.DisplayFor(modelItem => item.Name)</td>
                                        <td>@Html.DisplayFor(modelItem => item.Status)</td>
                                        <td>@Html.DisplayFor(modelItem => item.Remarks)</td>
                                        <td>@Html.DisplayFor(modelItem => item.FidNavigation.Name)</td>
                                        <td>@Html.DisplayFor(modelItem => item.Bu.Name)</td>
                                        <td>@Html.DisplayFor(modelItem => item.CidNavigation.CompanyName)</td>
                                        <td>
                                            <a asp-action="Edit" asp-route-id="@item.Lid" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i></a>
                                            <a asp-action="Details" asp-route-id="@item.Lid" class="btn btn-info btn-sm"><i class="fas fa-info-circle"></i></a>
                                            <a asp-action="Delete" asp-route-id="@item.Lid" class="btn btn-danger btn-sm"><i class="fas fa-trash-alt"></i></a>
                                        </td>

                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <!-- /.card-body -->
                </div>
                <!-- /.card -->
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>
<!-- /.content -->
@section Scripts {
    <script src="https://cdn.datatables.net/1.10.21/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.21/js/dataTables.bootstrap4.min.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.10.21/css/dataTables.bootstrap4.min.css" />

    <script>
        $(document).ready(function () {
            $('#machineLocationTable').DataTable({
                "paging": true,
                "lengthChange": false,
                "searching": true,
                "ordering": true,
                "info": true,
                "autoWidth": true,
                "responsive": true,
            });

            // Adjust row height
            $('#machineLocationTable tbody tr').css('height', '20px');
        });
    </script>
}
