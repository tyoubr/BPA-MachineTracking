@model BPAMachineTrack.Models.tbl_Layout

@{
    ViewData["Title"] = "Create";
}

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/css/select2.min.css" rel="stylesheet" />

<style>
    :root {
        --input-border: #e2e8f0;
        --input-focus: #6366f1;
    }

    .form-control,
    .form-select {
        min-height: 48px;
    }

    .select2-container {
        width: 100% !important;
    }

    .select2-container--default .select2-selection--single {
        height: 48px !important;
        border: 1px solid var(--input-border) !important;
        border-radius: 0.375rem !important;
        display: flex !important;
        align-items: center !important;
        background-color: #fff !important;
        box-shadow: 0 .125rem .25rem rgba(0, 0, 0, .075) !important;
    }

        .select2-container--default
        .select2-selection--single
        .select2-selection__rendered {
            line-height: 46px !important;
            padding-left: 16px !important;
            padding-right: 40px !important;
            font-size: 1.1rem !important;
            color: #212529 !important;
        }

        .select2-container--default
        .select2-selection--single
        .select2-selection__placeholder {
            color: #6c757d !important;
        }

        .select2-container--default
        .select2-selection--single
        .select2-selection__arrow {
            height: 46px !important;
            right: 8px !important;
        }

    .select2-container--default.select2-container--focus
    .select2-selection--single,
    .select2-container--default.select2-container--open
    .select2-selection--single {
        border-color: var(--input-focus) !important;
        box-shadow: 0 0 0 .25rem rgba(99, 102, 241, .15) !important;
    }

    .cause-section {
        display: none;
    }
</style>


<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8 col-md-10 col-12">

            <div class="card shadow-lg p-4 rounded-lg">

                <div class="card-body">

                    <h1 class="text-center text-primary mb-4">
                        Set Machine's Current Location
                    </h1>

                    <hr />

                    <form asp-action="Create" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <!-- =========================
                             DATE
                             ========================= -->

                        <div class="form-group mb-3">

                            <label asp-for="DATE"
                                   class="form-label">
                                Date
                            </label>

                            <input asp-for="DATE"
                                   id="DATE"
                                   class="form-control form-control-lg shadow-sm"
                                   type="date"
                                   required />

                            <span asp-validation-for="DATE"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- =========================
                             MACHINE
                             ========================= -->

                        <div class="form-group mb-3">

                            <label for="machineDropdown"
                                   class="form-label">
                                Select Machine
                            </label>

                            <select id="machineDropdown"
                                    name="MCID"
                                    class="form-select form-control-lg shadow-sm"
                                    required>

                                <option value="">
                                    -- Select a Machine --
                                </option>

                            </select>

                            <span asp-validation-for="MCID"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- =========================
                             LOCATION
                             ========================= -->

                        <div class="form-group mb-3">

                            <label for="lidDropdown"
                                   class="form-label">
                                Select Location
                            </label>

                            <select id="lidDropdown"
                                    name="LID"
                                    class="form-select form-control-lg shadow-sm"
                                    required>

                                <option value="">
                                    -- Select a Location --
                                </option>

                            </select>

                            <span asp-validation-for="LID"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- =========================
                             LOCATION DETAILS
                             ========================= -->

                        <div class="form-group mb-3">

                            <label asp-for="LOCATION_DETAILS"
                                   class="form-label">
                                Location Details
                            </label>

                            <input id="LOCATION_DETAILS"
                                   asp-for="LOCATION_DETAILS"
                                   class="form-control form-control-lg shadow-sm"
                                   readonly />

                            <span asp-validation-for="LOCATION_DETAILS"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- =========================
                             STATUS
                             ========================= -->

                        <div class="form-group mb-4">

                            <label asp-for="STATUS"
                                   class="form-label">
                                Status
                            </label>

                            <select asp-for="STATUS"
                                    id="statusDropdown"
                                    class="form-control form-control-lg shadow-sm"
                                    required>

                                <option value="">
                                    -- Select Machine Status --
                                </option>

                                <option value="Running">
                                    Running
                                </option>

                                <option value="Idle">
                                    Idle
                                </option>

                                <option value="Under maintenance">
                                    Under maintenance
                                </option>

                                <option value="Damaged">
                                    Damaged
                                </option>

                            </select>

                            <span asp-validation-for="STATUS"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- =================================================
                             IDLE CAUSE
                             TBL_MC_IDLE_CAUSE
                             PK = ICID
                             NAME = CAUSE_NAME
                             ================================================= -->

                        <div id="idleCauseSection"
                             class="form-group mb-4 cause-section">

                            <label asp-for="MachineIdleCause"
                                   class="form-label">

                                Idle Cause

                            </label>

                            <select asp-for="MachineIdleCause"
                                    id="MachineIdleCause"
                                    class="form-control form-control-lg shadow-sm">

                                <option value="">
                                    -- Select Idle Cause --
                                </option>

                            </select>

                            <span asp-validation-for="MachineIdleCause"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- =================================================
                             DAMAGE CAUSE
                             TBL_MC_DAMAGE_CAUSE
                             PK = DCID
                             NAME = CAUSE_NAME
                             ================================================= -->

                        <div id="damageCauseSection"
                             class="form-group mb-4 cause-section">

                            <label asp-for="MachineDmgCause"
                                   class="form-label">

                                Damage Cause

                            </label>

                            <select asp-for="MachineDmgCause"
                                    id="MachineDmgCause"
                                    class="form-control form-control-lg shadow-sm">

                                <option value="">
                                    -- Select Damage Cause --
                                </option>

                            </select>

                            <span asp-validation-for="MachineDmgCause"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- =================================================
                             UNDER MAINTENANCE CAUSE
                             TBL_MC_UM_CAUSE
                             PK = UMCID
                             NAME = CAUSE_NAME
                             ================================================= -->

                        <div id="umCauseSection"
                             class="form-group mb-4 cause-section">

                            <label asp-for="MachineUmCause"
                                   class="form-label">

                                Under Maintenance Cause

                            </label>

                            <select asp-for="MachineUmCause"
                                    id="MachineUmCause"
                                    class="form-control form-control-lg shadow-sm">

                                <option value="">
                                    -- Select Maintenance Cause --
                                </option>

                            </select>

                            <span asp-validation-for="MachineUmCause"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- =========================
                             SUBMIT
                             ========================= -->

                        <div class="d-flex justify-content-center">

                            <button type="submit"
                                    class="btn btn-primary btn-lg px-5 py-3 rounded-pill shadow-lg">

                                Create

                            </button>

                        </div>

                    </form>


                    <!-- =========================
                         BACK
                         ========================= -->

                    <div class="text-center mt-4">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary btn-sm px-4 py-2 rounded-pill shadow-sm">

                            Back to List

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <!-- jQuery -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

    <!-- Select2 -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/js/select2.min.js"></script>


    <script>

        $(document).ready(function () {

            // =========================================================
            // SELECT2 INITIALIZATION
            // =========================================================

            function initializeSelect2(selector, placeholder) {

                $(selector).select2({

                    placeholder: placeholder,

                    allowClear: true,

                    width: '100%',

                    minimumResultsForSearch: 0,

                    dropdownAutoWidth: true

                });

            }


            // =========================================================
            // MACHINE DROPDOWN
            // =========================================================

            $.ajax({

                url: '/Layout/GetAllMachineIds',

                type: 'GET',

                success: function (response) {

                    if (response.success) {

                        const dropdown = $('#machineDropdown');

                        dropdown.empty();

                        dropdown.append(
                            $('<option>', {
                                value: '',
                                text: '-- Select a Machine --'
                            })
                        );


                        response.data.forEach(function (machine) {

                            dropdown.append(

                                new Option(

                                    `${machine.mcid} - ${machine.srno}`,

                                    machine.mcid

                                )

                            );

                        });


                        initializeSelect2(

                            '#machineDropdown',

                            'Type to search by MCID or Serial No'

                        );

                    }
                    else {

                        alert(

                            response.message ||
                            'Failed to load machine IDs.'

                        );

                    }

                },

                error: function () {

                    alert(
                        'Error loading machine data.'
                    );

                }

            });


            // =========================================================
            // LOCATION DROPDOWN
            // =========================================================

            $.ajax({

                url: '/Layout/GetAllLocationIds',

                type: 'GET',

                success: function (response) {

                    if (response.success) {

                        const dropdown = $('#lidDropdown');

                        dropdown.empty();

                        dropdown.append(

                            $('<option>', {

                                value: '',

                                text: '-- Select a Location --'

                            })

                        );


                        response.data.forEach(function (location) {

                            dropdown.append(

                                new Option(

                                    `${location.lid} - ${location.name} - ${location.companyName}`,

                                    location.lid

                                )

                            );

                        });


                        initializeSelect2(

                            '#lidDropdown',

                            'Type to search by Location ID or Name'

                        );

                    }
                    else {

                        alert(

                            response.message ||
                            'Failed to load location IDs.'

                        );

                    }

                },

                error: function () {

                    alert(
                        'Error loading location data.'
                    );

                }

            });


            // =========================================================
            // LOCATION DETAILS
            // =========================================================

            $('#lidDropdown').on('change', function () {

                const lid = $(this).val();


                if (lid) {

                    $.ajax({

                        url: '/Layout/GetLocationDetails',

                        type: 'GET',

                        data: {
                            Lid: lid
                        },

                        success: function (response) {

                            if (response.success) {

                                const details =
                                    response.data;


                                $('#LOCATION_DETAILS').val(

                                    `${details.companyName} - ${details.buildingName}, ${details.floorName}`

                                );

                            }
                            else {

                                $('#LOCATION_DETAILS').val('');

                            }

                        },

                        error: function () {

                            $('#LOCATION_DETAILS').val('');

                        }

                    });

                }
                else {

                    $('#LOCATION_DETAILS').val('');

                }

            });


            // =========================================================
            // LOAD IDLE CAUSES
            // TBL_MC_IDLE_CAUSE
            // PK: ICID
            // NAME: CAUSE_NAME
            // =========================================================

            function loadIdleCauses() {

                const dropdown =
                    $('#MachineIdleCause');


                // Don't reload if already loaded

                if (
                    dropdown.children('option').length > 1
                ) {

                    return;

                }


                $.ajax({

                    url: '/Layout/GetIdleCauses',

                    type: 'GET',

                    success: function (response) {

                        if (response.success) {

                            dropdown.empty();


                            dropdown.append(

                                $('<option>', {

                                    value: '',

                                    text:
                                        '-- Select Idle Cause --'

                                })

                            );


                            response.data.forEach(
                                function (item) {

                                    dropdown.append(

                                        new Option(

                                            item.causeName,

                                            item.icid

                                        )

                                    );

                                }
                            );


                            // Refresh Select2

                            dropdown.trigger('change.select2');

                        }
                        else {

                            alert(

                                response.message ||
                                'Failed to load idle causes.'

                            );

                        }

                    },

                    error: function () {

                        alert(
                            'Error loading idle causes.'
                        );

                    }

                });

            }


            // =========================================================
            // LOAD DAMAGE CAUSES
            // TBL_MC_DAMAGE_CAUSE
            // PK: DCID
            // NAME: CAUSE_NAME
            // =========================================================

            function loadDamageCauses() {

                const dropdown =
                    $('#MachineDmgCause');


                // Don't reload if already loaded

                if (
                    dropdown.children('option').length > 1
                ) {

                    return;

                }


                $.ajax({

                    url: '/Layout/GetDamageCauses',

                    type: 'GET',

                    success: function (response) {

                        if (response.success) {

                            dropdown.empty();


                            dropdown.append(

                                $('<option>', {

                                    value: '',

                                    text:
                                        '-- Select Damage Cause --'

                                })

                            );


                            response.data.forEach(
                                function (item) {

                                    dropdown.append(

                                        new Option(

                                            item.causeName,

                                            item.dcid

                                        )

                                    );

                                }
                            );


                            // Refresh Select2

                            dropdown.trigger('change.select2');

                        }
                        else {

                            alert(

                                response.message ||
                                'Failed to load damage causes.'

                            );

                        }

                    },

                    error: function () {

                        alert(
                            'Error loading damage causes.'
                        );

                    }

                });

            }


            // =========================================================
            // LOAD UNDER MAINTENANCE CAUSES
            // TBL_MC_UM_CAUSE
            // PK: UMCID
            // NAME: CAUSE_NAME
            // =========================================================

            function loadUmCauses() {

                const dropdown =
                    $('#MachineUmCause');


                // Don't reload if already loaded

                if (
                    dropdown.children('option').length > 1
                ) {

                    return;

                }


                $.ajax({

                    url: '/Layout/GetUmCauses',

                    type: 'GET',

                    success: function (response) {

                        if (response.success) {

                            dropdown.empty();


                            dropdown.append(

                                $('<option>', {

                                    value: '',

                                    text:
                                        '-- Select Maintenance Cause --'

                                })

                            );


                            response.data.forEach(
                                function (item) {

                                    dropdown.append(

                                        new Option(

                                            item.causeName,

                                            item.umcid

                                        )

                                    );

                                }
                            );


                            // Refresh Select2

                            dropdown.trigger('change.select2');

                        }
                        else {

                            alert(

                                response.message ||
                                'Failed to load maintenance causes.'

                            );

                        }

                    },

                    error: function () {

                        alert(
                            'Error loading maintenance causes.'
                        );

                    }

                });

            }


            // =========================================================
            // INITIALIZE CAUSE SELECT2
            // =========================================================

            initializeSelect2(

                '#MachineIdleCause',

                '-- Select Idle Cause --'

            );


            initializeSelect2(

                '#MachineDmgCause',

                '-- Select Damage Cause --'

            );


            initializeSelect2(

                '#MachineUmCause',

                '-- Select Maintenance Cause --'

            );


            // =========================================================
            // STATUS CHANGE
            // =========================================================

            $('#statusDropdown').on('change', function () {

                const status = $(this).val();


                // =====================================================
                // HIDE ALL CAUSE SECTIONS
                // =====================================================

                $('#idleCauseSection').hide();

                $('#damageCauseSection').hide();

                $('#umCauseSection').hide();


                // =====================================================
                // REMOVE REQUIRED FROM ALL
                // =====================================================

                $('#MachineIdleCause')
                    .prop('required', false);

                $('#MachineDmgCause')
                    .prop('required', false);

                $('#MachineUmCause')
                    .prop('required', false);


                // =====================================================
                // CLEAR ALL CAUSES
                // =====================================================

                $('#MachineIdleCause')
                    .val('')
                    .trigger('change');


                $('#MachineDmgCause')
                    .val('')
                    .trigger('change');


                $('#MachineUmCause')
                    .val('')
                    .trigger('change');


                // =====================================================
                // IDLE
                // =====================================================

                if (status === 'Idle') {

                    $('#idleCauseSection').show();


                    // REQUIRED

                    $('#MachineIdleCause')
                        .prop('required', true);


                    // LOAD DATA

                    loadIdleCauses();

                }


                // =====================================================
                // DAMAGED
                // =====================================================

                else if (status === 'Damaged') {

                    $('#damageCauseSection').show();


                    // REQUIRED

                    $('#MachineDmgCause')
                        .prop('required', true);


                    // LOAD DATA

                    loadDamageCauses();

                }


                // =====================================================
                // UNDER MAINTENANCE
                // =====================================================

                else if (

                    status === 'Under maintenance' ||

                    status === 'Under Maintenance'

                ) {

                    $('#umCauseSection').show();


                    // REQUIRED

                    $('#MachineUmCause')
                        .prop('required', true);


                    // LOAD DATA

                    loadUmCauses();

                }


                // =====================================================
                // RUNNING
                // =====================================================

                else if (status === 'Running') {

                    // Nothing to show

                }

            });


            // =========================================================
            // DEFAULT DATE
            // =========================================================

            const today =
                new Date()
                    .toISOString()
                    .split('T')[0];


            $('#DATE').val(today);


            // =========================================================
            // INITIAL STATE
            // =========================================================

            $('#idleCauseSection').hide();

            $('#damageCauseSection').hide();

            $('#umCauseSection').hide();


            // =========================================================
            // INITIAL REQUIRED STATE
            // =========================================================

            $('#MachineIdleCause')
                .prop('required', false);

            $('#MachineDmgCause')
                .prop('required', false);

            $('#MachineUmCause')
                .prop('required', false);


            // =========================================================
            // FORM SUBMIT VALIDATION
            // Extra safety
            // =========================================================

            $('form').on('submit', function (e) {

                const status =
                    $('#statusDropdown').val();


                // =====================================================
                // IDLE VALIDATION
                // =====================================================

                if (status === 'Idle') {

                    const cause =
                        $('#MachineIdleCause').val();


                    if (!cause) {

                        e.preventDefault();


                        $('#idleCauseSection').show();


                        $('#MachineIdleCause')
                            .prop('required', true);


                        alert(
                            'Please select an Idle Cause.'
                        );


                        return false;
                    }

                }


                // =====================================================
                // DAMAGE VALIDATION
                // =====================================================

                if (status === 'Damaged') {

                    const cause =
                        $('#MachineDmgCause').val();


                    if (!cause) {

                        e.preventDefault();


                        $('#damageCauseSection').show();


                        $('#MachineDmgCause')
                            .prop('required', true);


                        alert(
                            'Please select a Damage Cause.'
                        );


                        return false;
                    }

                }


                // =====================================================
                // UNDER MAINTENANCE VALIDATION
                // =====================================================

                if (

                    status === 'Under maintenance' ||

                    status === 'Under Maintenance'

                ) {

                    const cause =
                        $('#MachineUmCause').val();


                    if (!cause) {

                        e.preventDefault();


                        $('#umCauseSection').show();


                        $('#MachineUmCause')
                            .prop('required', true);


                        alert(
                            'Please select a Maintenance Cause.'
                        );


                        return false;
                    }

                }


                // =====================================================
                // RUNNING
                // =====================================================

                if (status === 'Running') {

                    // No cause validation required

                }


                // =====================================================
                // ALLOW SUBMIT
                // =====================================================

                return true;

            });

        });

    </script>
}

