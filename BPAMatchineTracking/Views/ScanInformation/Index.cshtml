@model IEnumerable<BPAMatchineTrack.Models.TblScanInformation>

@{
    ViewData["Title"] = "Scan Information";
}

<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>@ViewData["Title"]</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="~/Home/Index">Home</a></li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Scan Information</h3>
                        <div class="card-tools">
                            <a href="@Url.Action("Create")" class="btn btn-primary btn-sm ml-2"><i class="fas fa-plus"></i> Scan New</a>
                        </div>
                    </div>
                    <!-- /.card-header -->
                    <div class="card-body p-0">
                        <table id="scanInfoTable" class="table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Location</th>
                                    <th>Details</th>
                                    <th>Barcode</th>
                                    <th>Remarks</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody id="searchResults">
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.Scdate</td>
                                        <td>@item.Lid</td>
                                        <td>@item.Details</td>
                                        <td>@item.Barcode</td>
                                        <td>@item.Remarks</td>
                                        <td>@item.Status</td>
                                        <td>
                                            <a href="@Url.Action("Edit", new { id = item.Scid })" class="btn btn-sm btn-info" title="Edit"><i class="fas fa-edit"></i></a>
                                            <a href="@Url.Action("Details", new { id = item.Scid })" class="btn btn-sm btn-secondary" title="Details"><i class="fas fa-info-circle"></i></a>
                                            <a href="@Url.Action("Delete", new { id = item.Scid })" class="btn btn-sm btn-danger" title="Delete"><i class="fas fa-trash-alt"></i></a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <!-- /.card-body -->
                    <div class="card-footer">
                        <div class="pagination">
                            @if (ViewBag.CurrentPage > 1)
                            {
                                <a href="@Url.Action("Index", new { page = ViewBag.CurrentPage - 1, searchTerm = ViewData["searchTerm"] })" class="btn btn-secondary">Previous</a>
                            }

                            @for (int i = 1; i <= ViewBag.TotalPages; i++)
                            {
                                // Show only a limited number of page links
                                if (i == 1 || i == ViewBag.TotalPages || (i >= ViewBag.CurrentPage - 1 && i <= ViewBag.CurrentPage + 1))
                                {
                                    <a href="@Url.Action("Index", new { page = i, searchTerm = ViewData["searchTerm"] })" class="btn btn-secondary @(ViewBag.CurrentPage == i ? "active" : "")">@i</a>
                                }
                                else if (i == ViewBag.CurrentPage - 2 || i == ViewBag.CurrentPage + 2)
                                {
                                    <span class="btn btn-secondary disabled">...</span>
                                }
                            }

                            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                            {
                                <a href="@Url.Action("Index", new { page = ViewBag.CurrentPage + 1, searchTerm = ViewData["searchTerm"] })" class="btn btn-secondary">Next</a>
                            }
                        </div>
                    </div>

                </div>
                <!-- /.card -->
            </div>
            <!-- /.col -->
        </div>
        <!-- /.row -->
    </div><!-- /.container-fluid -->
</section>
<!-- /.content -->
