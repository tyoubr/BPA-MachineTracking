@model BPAMatchineTrack.Models.ErrorViewModel

<div class="text-danger">
    <h1 class="display-4">Error.</h1>
    <h2 class="display-6">An error occurred while processing your request.</h2>
    <p>
        <strong>Request ID:</strong> @Model.RequestId
    </p>
    <p>
        <strong>Development Mode:</strong> Swapping to Development environment will display more detailed information about the error that occurred.
    </p>
</div>
