@model IEnumerable<BPAMatchineTrack.Models.tbl_Rent_MC_Requisition>

<div class="container-fluid mt-5">
    <!-- Using container-fluid for full width -->
    <h2 class="text-center">Requisition List</h2>
    <div class="text-end mb-3">
        <a href="@Url.Action("Create", "RentMCRequisition")" class="btn btn-primary">
            Create New
        </a>
    </div>
    <table class="table table-striped table-bordered w-100">
        <thead>
            <tr>
                <th>Requisition ID</th>
                <th>Booking No</th>
                <th>Requested For</th>
                <th>Requisition Date</th>
                <th>Required Date</th>
                <th>Company</th> <!-- Add Company column here -->
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var requisition in Model)
            {
                <tr>
                    <td>@requisition.RID</td>
                    <td>@requisition.BOOKING_NO</td>
                    <td>@requisition.REQ_FOR</td>
                    <td>@requisition.RDATE?.ToString("yyyy-MM-dd")</td>
                    <td>@requisition.REQUIRED_DATE?.ToString("yyyy-MM-dd")</td>
                    <td>@requisition.Company?.CompanyName</td> <!-- Display Company Name here -->
                    <td>
                        <div class="btn-group" role="group">
                            <!-- Action buttons -->
                            <a href="@Url.Action("RentMCRequisition", "ReportCalling", new { id = requisition.RID })" target="_blank" class="btn btn-light">
                                <i class="fa fa-print"></i>
                            </a>
                            <a href="@Url.Action("Edit", "RentMCRequisition", new { id = requisition.RID })" class="btn btn-warning">Edit</a>
                            <a href="@Url.Action("Delete", "RentMCRequisition", new { id = requisition.RID })" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this item?');">Delete</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>

<style>
    .table {
        width: 100%; /* Ensures the table takes full width */
    }

        /* Adjusting padding for thinner rows */
        .table th, .table td {
            padding: 4px 5px; /* Adjust the padding values for thinner rows */
            vertical-align: middle; /* Aligns text vertically */
        }

    .btn-group .btn {
        margin-right: 5px; /* Adds spacing between buttons */
    }

        .btn-group .btn:last-child {
            margin-right: 0; /* No margin on the last button */
        }

    thead th {
        background-color: #007bff; /* Bootstrap primary color */
        color: white; /* Text color for header */
    }

    tbody tr:hover {
        background-color: #f1f1f1; /* Light grey background on hover */
    }
</style>

