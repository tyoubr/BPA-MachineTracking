            @Html.DisplayFor(model => model.DATE)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.MCID)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.MCID)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.LID)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.LID)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.LOCATION_DETAILS)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.LOCATION_DETAILS)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.STATUS)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.STATUS)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.SLNO" class="btn btn-primary btn-sm">Edit</a>
    <a asp-action="Index" class="btn btn-secondary btn-sm">Back to List</a>
</div>
