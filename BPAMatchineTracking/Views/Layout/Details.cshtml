@model BPAMachineTrack.Models.tbl_Layout

@{
    ViewData["Title"] = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Details</h1>

<style>
    dl.row dt, dl.row dd {
        margin-bottom: 5px; /* Reduces space between rows */
        padding: 2px 0; /* Adjusts padding */
        line-height: 1.2; /* Reduces the space inside the row */
    }
</style>

<div>
    <h4>tbl_Layout</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DATE)
